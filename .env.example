# Booking service: Base64 256-bit key for encrypting personal data at rest (ADR-0010).
# Generate one with:  openssl rand -base64 32
# Never commit a real key.
SKYHUB_PII_KEY=

# Booking service: Base64 256-bit key that signs manage-booking tokens (ADR-0011). Use a DIFFERENT key from the one above.
# Generate one with:  openssl rand -base64 32
SKYHUB_MANAGE_TOKEN_KEY=
SKYHUB_BOARDING_PASS_KEY=

# Booking AND notification services: Base64 256-bit key that seals one-time link tokens in events (ADR-0046). Set the SAME value on both;
# the booking service will not start without it. Use a DIFFERENT key from the ones above.
# Generate one with:  openssl rand -base64 32
SKYHUB_LINK_TOKEN_KEY=

# Booking and notification services: where Kafka is (ADR-0019). Defaults to the broker in docker compose.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Notification service: the SMTP server (ADR-0021). Defaults to Mailpit from docker compose (inbox at http://localhost:8025).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SKYHUB_EMAIL_FROM=SkyHub <no-reply@skyhub.example>
# SKYHUB_EMAIL_MODE=smtp   # or "log" to write emails to the log instead of sending

# Disruption agent as a service (ADR-0024): the agent and the website share this secret (32+ random characters).
# The website's server reads both; start the agent with `python -m disruption_agent.web` (port 8084).
# SKYHUB_AGENT_API_URL=http://localhost:8084
# SKYHUB_AGENT_API_TOKEN=

# Disruption agent (ADR-0022): an OPS staff account the agent logs in with, and a free Groq key (console.groq.com).
# SKYHUB_AGENT_USERNAME=agent.ops
# SKYHUB_AGENT_PASSWORD=
# GROQ_API_KEY=

# Booking service: the first administrator (ADR-0017), created once when there are no staff accounts yet.
# The password needs 12 to 72 characters (72 bytes at most: accents count for more than one; ADR-0048). Optional; without them the service starts with no staff and the ops endpoints stay closed.
SKYHUB_BOOTSTRAP_ADMIN_USERNAME=
SKYHUB_BOOTSTRAP_ADMIN_PASSWORD=

# Grafana login for the observability profile. Never commit a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
