# Booking service: Base64 256-bit key for encrypting personal data at rest (ADR-0010).
# Generate one with:  openssl rand -base64 32
# Never commit a real key.
SKYHUB_PII_KEY=

# Grafana login for the observability profile. Never commit a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
