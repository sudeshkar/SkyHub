# Booking service: Base64 256-bit key for encrypting personal data at rest (ADR-0010).
# Generate one with:  openssl rand -base64 32
# Never commit a real key.
SKYHUB_PII_KEY=

# Booking service: Base64 256-bit key that signs manage-booking tokens (ADR-0011). Use a DIFFERENT key from the one above.
# Generate one with:  openssl rand -base64 32
SKYHUB_MANAGE_TOKEN_KEY=
SKYHUB_BOARDING_PASS_KEY=

# Booking and notification services: where Kafka is (ADR-0019). Defaults to the broker in docker compose.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Booking service: the first administrator (ADR-0017), created once when there are no staff accounts yet.
# The password needs 12+ characters. Optional; without them the service starts with no staff and the ops endpoints stay closed.
SKYHUB_BOOTSTRAP_ADMIN_USERNAME=
SKYHUB_BOOTSTRAP_ADMIN_PASSWORD=

# Grafana login for the observability profile. Never commit a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
