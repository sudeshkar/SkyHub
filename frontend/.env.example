# Copy to .env.local. Server-side only — never exposed to the browser.
SKYHUB_SEARCH_API_URL=http://localhost:8081
SKYHUB_BOOKING_API_URL=http://localhost:8082
# Rate limiting (ADR-0009)
REDIS_URL=redis://localhost:6379
# Only "true" behind our own load balancer, which sets X-Forwarded-For.
SKYHUB_TRUST_PROXY=false
